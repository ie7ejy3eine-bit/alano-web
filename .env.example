# MongoDB Atlas connection string (https://www.mongodb.com/cloud/atlas)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/alano

# Server port
PORT=3000

# REQUIRED in production: long random string (npm run setup generates one for you)
JWT_SECRET=change-this-to-a-long-random-string

# Admin account, created automatically on first start (min 8 characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Optional: allow another site to call the API (comma separated). Leave empty for same-origin.
# CORS_ORIGIN=https://your-domain.com

NODE_ENV=development
